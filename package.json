{
    "name": "playwright-orchestrator",
    "version": "1.7.0",
    "engines": {
        "node": ">=22.0.0"
    },
    "packageManager": "pnpm@10.28.0",
    "directories": {
        "test": "tests"
    },
    "scripts": {
        "watch": "tsc -b -w",
        "test": "vitest run --pool=threads",
        "build": "tsc -b --clean && tsc -b --sourceMap false",
        "typecheck": "tsc -b",
        "lint": "eslint .",
        "format": "prettier --write \"**/*.{ts,cts,mts,js,mjs}\"",
        "format:check": "prettier --check \"**/*.{ts,cts,mts,js,mjs}\"",
        "test:unit": "vitest run --pool=threads --exclude=**/e2e/**",
        "test:e2e": "npx --yes http-server ./e2e/web-server-simulation -p 4321 --silent & SERVER_PID=$!; trap 'kill $SERVER_PID' EXIT && vitest run **/e2e/** --pool=threads --maxWorkers=2",
        "test:ci": "npx --yes http-server ./e2e/web-server-simulation -p 4321 --silent & SERVER_PID=$!; trap 'kill $SERVER_PID' EXIT && vitest run --pool=threads --maxWorkers=1",
        "run:web-server": "npx --yes http-server ./e2e/web-server-simulation -p 4321 --silent > /dev/null 2>&1 &",
        "stop:web-server": "kill -9 $(lsof -ti:4321)",
        "test-update": "vitest -u",
        "start": "node --inspect packages/core/dist/cli",
        "dynamo-local": "podman compose -f ./packages/dynamo-db/compose.yml",
        "pg-local": "podman compose -f ./packages/pg/compose.yml",
        "mysql-local": "podman compose -f ./packages/mysql/compose.yml",
        "mongo-local": "podman compose -f ./packages/mongo/compose.yml",
        "redis-local": "podman compose -f ./packages/redis/compose.yml",
        "version:patch": "pnpm -r --include-workspace-root exec -- pnpm version patch --no-git-tag-version",
        "version:minor": "pnpm -r --include-workspace-root exec -- pnpm version minor --no-git-tag-version",
        "version:major": "pnpm -r --include-workspace-root exec -- pnpm version major --no-git-tag-version"
    },
    "private": true,
    "keywords": [],
    "author": "Rostyslav Kudrevatykh",
    "license": "Apache-2.0",
    "description": "",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/rostmanrk/playwright-orchestrator.git"
    },
    "pnpm": {
        "overrides": {
            "@playwright-orchestrator/core": "workspace:*",
            "@playwright-orchestrator/dynamo-db": "workspace:*",
            "@playwright-orchestrator/file": "workspace:*",
            "@playwright-orchestrator/mongo": "workspace:*",
            "@playwright-orchestrator/mysql": "workspace:*",
            "@playwright-orchestrator/pg": "workspace:*",
            "@playwright-orchestrator/redis": "workspace:*",
            "@playwright/test": "^1.64.1",
            "playwright": "^1.64.1",
            "@actions/http-client>undici": "^6.29.1"
        }
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@playwright-orchestrator/core": "workspace:*",
        "@playwright-orchestrator/dynamo-db": "workspace:*",
        "@playwright-orchestrator/file": "workspace:*",
        "@playwright-orchestrator/mongo": "workspace:*",
        "@playwright-orchestrator/mysql": "workspace:*",
        "@playwright-orchestrator/pg": "workspace:*",
        "@playwright-orchestrator/redis": "workspace:*",
        "@playwright/test": "^1.64.1",
        "@testcontainers/mysql": "^12.0.0",
        "@testcontainers/postgresql": "^12.0.0",
        "@testcontainers/redis": "^12.0.0",
        "@types/node": "^22.10.2",
        "@types/proper-lockfile": "^4.1.4",
        "esbuild": "^0.28.1",
        "eslint": "^10.13.0",
        "eslint-config-prettier": "^10.1.8",
        "globals": "^17.13.0",
        "playwright": "^1.64.1",
        "prettier": "3.4.2",
        "proper-lockfile": "^4.1.2",
        "testcontainers": "^12.0.0",
        "typescript": "^5.7.3",
        "typescript-eslint": "^8.72.1",
        "vite": "^7.3.7",
        "vitest": "^4.1.10"
    }
}
